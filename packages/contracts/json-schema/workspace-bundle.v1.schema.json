{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "urn:struinfo:contracts:workspace-bundle:v1",
  "title": "StruInfo Workspace Bundle v1 Envelope",
  "description": "Canonical UTF-8 JSON envelope. Every section payload also requires a registered type-and-version codec before import.",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "blobReferences",
    "exportedAt",
    "format",
    "secretHandling",
    "sections",
    "version",
    "workspaceId"
  ],
  "properties": {
    "blobReferences": {
      "type": "array",
      "items": {"$ref": "#/$defs/blobReference"}
    },
    "exportedAt": {"type": "string", "format": "date-time"},
    "format": {"const": "struinfo.workspace-bundle"},
    "secretHandling": {"const": "excluded"},
    "sections": {
      "type": "array",
      "items": {"$ref": "#/$defs/section"}
    },
    "version": {"const": 1},
    "workspaceId": {
      "type": "string",
      "pattern": "^[A-Za-z0-9][A-Za-z0-9._-]{0,127}$"
    }
  },
  "$defs": {
    "blobReference": {
      "type": "object",
      "additionalProperties": false,
      "required": ["algorithm", "byteLength", "digest"],
      "properties": {
        "algorithm": {"const": "sha256"},
        "byteLength": {
          "type": "integer",
          "minimum": 0,
          "maximum": 9007199254740991
        },
        "digest": {"type": "string", "pattern": "^[a-f0-9]{64}$"}
      }
    },
    "section": {
      "type": "object",
      "additionalProperties": false,
      "required": ["payload", "type", "version"],
      "properties": {
        "payload": {
          "$comment": "Validated by the registered section codec; unknown section contracts are rejected."
        },
        "type": {
          "type": "string",
          "pattern": "^[A-Za-z0-9][A-Za-z0-9._-]{0,127}$"
        },
        "version": {
          "type": "integer",
          "minimum": 1,
          "maximum": 9007199254740991
        }
      }
    }
  }
}

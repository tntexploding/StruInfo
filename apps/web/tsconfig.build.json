{
  "$schema": "https://json.schemastore.org/tsconfig",
  "extends": "./tsconfig.json",
  "compilerOptions": {
    "noEmit": false,
    "composite": true,
    "declaration": true,
    "declarationMap": true,
    "emitDeclarationOnly": true,
    "rootDir": ".",
    "outDir": "./.cache/typescript",
    "tsBuildInfoFile": "./.cache/typescript/.tsbuildinfo"
  },
  "exclude": ["dist", "node_modules"]
}

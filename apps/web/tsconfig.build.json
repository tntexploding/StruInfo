{
  "$schema": "https://json.schemastore.org/tsconfig",
  "extends": "./tsconfig.json",
  "compilerOptions": {
    "noEmit": false,
    "composite": true,
    "declaration": true,
    "declarationMap": true,
    "emitDeclarationOnly": true,
    "rootDir": "./src",
    "outDir": "./.cache/typescript",
    "tsBuildInfoFile": "./.cache/typescript/.tsbuildinfo"
  },
  "exclude": ["src/**/*.test.ts", "src/**/*.test.tsx"]
}

{
  "$schema": "https://json.schemastore.org/tsconfig",
  "extends": "./tsconfig.base.json",
  "compilerOptions": {
    "noEmit": true,
    "experimentalDecorators": true,
    "emitDecoratorMetadata": true,
    "jsx": "react-jsx",
    "lib": ["ES2023", "DOM", "DOM.Iterable"],
    "types": ["node"]
  },
  "include": [
    "./apps/**/*.test.ts",
    "./apps/**/*.test.tsx",
    "./packages/**/*.test.ts",
    "./packages/**/*.test.tsx",
    "./tests/**/*.ts",
    "./tools/**/*.test.ts"
  ],
  "exclude": ["./tests/postgres/**/*.ts"]
}

{
  "$schema": "https://json.schemastore.org/tsconfig",
  "extends": "./tsconfig.base.json",
  "compilerOptions": {
    "noEmit": true,
    "lib": ["ES2023", "DOM", "DOM.Iterable"],
    "types": ["node"]
  },
  "include": [
    "./apps/**/*.test.ts",
    "./apps/**/*.test.tsx",
    "./packages/**/*.test.ts",
    "./packages/**/*.test.tsx",
    "./tests/**/*.ts"
  ]
}
